<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- OTDU_ADDITION: process code page = UTF-8 (Windows 10 1903+; ignored on
     older systems). Paths are kept as UTF-8 std::string and opened through the
     narrow file APIs, which otherwise fail for non-ASCII folders (e.g. a
     localized Documents folder holding the save games and CDKey.txt). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
